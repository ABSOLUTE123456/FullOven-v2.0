@{
    ViewData["Title"] = "CSV Экспорт и Импорт";
}

<div style="max-width: 680px; margin: 40px auto; padding: 35px; background: linear-gradient(145deg, #2b2520, #211c19); border-radius: 12px; border: 1px solid rgba(201, 160, 84, 0.15); color: #ffffff; font-family: 'Segoe UI', system-ui, sans-serif; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);">

    <h2 style="margin: 0 0 30px 0; color: #ffffff; font-size: 1.6rem; font-weight: 600; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 15px;">
        <span style="color: #c9a054;">📊</span> Управление данными CSV (ЛР22)
    </h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="padding: 12px 18px; background-color: rgba(76, 175, 80, 0.15); border-left: 4px solid #4caf50; color: #81c784; border-radius: 0 6px 6px 0; margin-bottom: 25px; font-size: 0.92rem;">
            ✨ @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div style="padding: 12px 18px; background-color: rgba(244, 67, 54, 0.15); border-left: 4px solid #f44336; color: #e57373; border-radius: 0 6px 6px 0; margin-bottom: 25px; font-size: 0.92rem;">
            ❌ @TempData["ErrorMessage"]
        </div>
    }

    <div style="margin-bottom: 30px; background: rgba(0, 0, 0, 0.15); padding: 20px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.02);">
        <h4 style="margin: 0 0 15px 0; color: #c9a054; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">📥 Выгрузка данных</h4>
        <p style="color: rgba(255,255,255,0.7); font-size: 0.9rem; margin-bottom: 15px; line-height: 1.5;">Экспортируйте все текущие блюда ресторана в текстовую таблицу формата CSV, совместимую с Microsoft Excel.</p>
        <a asp-controller="Csv" asp-action="Export" style="display: inline-block; text-align: center; text-decoration: none; width: 100%; padding: 12px; background: linear-gradient(90deg, #c9a054, #b0873d); border: none; border-radius: 6px; color: #1c1815; font-size: 0.95rem; font-weight: 700; cursor: pointer; box-shadow: 0 4px 15px rgba(201, 160, 84, 0.2); transition: all 0.2s ease; box-sizing: border-box;">Запустить экспорт в CSV</a>
    </div>

    <div style="background: rgba(0, 0, 0, 0.15); padding: 20px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.02);">
        <h4 style="margin: 0 0 15px 0; color: #c9a054; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">📤 Загрузка данных</h4>

        <form method="post" enctype="multipart/form-data" asp-controller="Csv" asp-action="Import">
            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 6px; color: rgba(255,255,255,0.7); font-size: 0.88rem;">Выберите CSV-файл таблицы</label>
                <input type="file" name="csvFile" accept=".csv" style="width: 100%; padding: 10px 12px; background-color: #3d342d; border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; color: #ffffff; font-size: 0.95rem; outline: none; box-sizing: border-box;" required />
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 6px; color: rgba(255,255,255,0.7); font-size: 0.88rem;">Режим обработки импорта</label>
                <select name="importMode" style="width: 100%; padding: 10px 12px; background-color: #3d342d; border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; color: #ffffff; font-size: 0.95rem; outline: none; box-sizing: border-box;">
                    <!option value="Merge">Merge — Добавить новые позиции к текущему меню</!option>
                    <!option value="Replace">Replace — Заменить всё текущее меню данными из файла</!option>
                </select>
            </div>

            <button type="submit" style="width: 100%; padding: 12px; background-color: #4caf50; border: none; border-radius: 6px; color: #ffffff; font-size: 0.95rem; font-weight: 700; cursor: pointer; box-shadow: 0 4px 15px rgba(76, 175, 80, 0.2); transition: all 0.2s ease;">Выполнить импорт из CSV</button>
        </form>
    </div>
</div>
