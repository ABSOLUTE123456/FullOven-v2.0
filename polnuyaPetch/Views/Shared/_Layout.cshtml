@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="ru" style="height: 100%;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - FullOven</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="display: flex; flex-direction: column; min-height: 100vh; margin: 0; background-color: #3d342d;">
    <header class="header" style="flex-shrink: 0;">
        <div class="container header-content">
            <div class="logo">
                <a asp-controller="Home" asp-action="Index" style="text-decoration: none; color: inherit;">
                    <div class="logo-top">
                        <span class="logo-name">FULL OVEN</span>
                        <img src="~/images/Group.svg" alt="icon" class="logo-icon">
                    </div>
                    <p class="logo-sub">Ресторан русской кухни</p>
                </a>
            </div>
            <nav class="nav" style="display: flex; align-items: center; gap: 15px; position: relative;">
                <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">главная</a>
                <a asp-controller="Home" asp-action="Menu" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Menu" ? "active" : "")">меню</a>
                <a asp-controller="Home" asp-action="Addresses" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Addresses" ? "active" : "")">наши места</a>
                <a asp-controller="Home" asp-action="Reservation" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Reservation" ? "active" : "")">бронирование</a>
                <a asp-controller="Home" asp-action="Connection" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Connection" ? "active" : "")">контакты</a>

                <div class="dropdown-admin" style="position: relative; display: inline-block; padding-bottom: 15px; margin-bottom: -15px;">
                    <a href="#" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Csv" || ViewContext.RouteData.Values["Action"]?.ToString() == "AdminReservations" || ViewContext.RouteData.Values["Action"]?.ToString() == "Settings" ? "active" : "")" style="cursor: pointer; display: flex; align-items: center; gap: 4px; user-select: none;">
                        админка <span style="font-size: 0.65rem; transition: transform 0.2s ease;">▼</span>
                    </a>
                    <div class="dropdown-content">
                        <a asp-controller="Home" asp-action="AdminReservations" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "AdminReservations" ? "dropdown-active" : "")">заказы</a>
                        <a asp-controller="Home" asp-action="Settings" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Settings" ? "dropdown-active" : "")">настройки</a>
                        <a asp-controller="Csv" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Csv" ? "dropdown-active" : "")">таблица (CSV)</a>
                    </div>
                </div>

                @{
                    var userLogin = HttpContextAccessor.HttpContext?.Session.GetString("UserLogin");
                }

                @if (!string.IsNullOrEmpty(userLogin))
                {
                    <a asp-controller="Home" asp-action="Profile" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "active" : "")">профиль</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Login" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Login" ? "active" : "")">войти</a>
                }

                <div class="nav-underline"></div>
            </nav>
        </div>
    </header>

    <main style="flex-grow: 1; flex-shrink: 0;">
        @RenderBody()
    </main>

    <footer style="flex-shrink: 0; padding: 20px 0; background-color: #2b2520; color: rgba(255,255,255,0.5); text-align: center; font-size: 0.9rem; border-top: 1px solid rgba(255,255,255,0.05); width: 100%;">
        <div class="container">
            <p style="margin: 0;">&copy; @DateTime.Now.Year - FullOven. Все права защищены. <span style="margin-left: 10px; color: #ffffff; opacity: 0.8;">v@(typeof(polnuyaPetch.Controllers.HomeController).Assembly.GetName().Version?.ToString(3) ?? "1.0.0")</span></p>
        </div>
    </footer>

    <style>
        .dropdown-admin {
            position: relative;
            display: inline-block;
            padding-bottom: 15px;
            margin-bottom: -15px;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #2b2520;
            min-width: 190px;
            box-shadow: 0px 10px 25px rgba(0,0,0,0.6);
            border: 1px solid rgba(201, 160, 84, 0.2);
            border-radius: 6px;
            z-index: 99999;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            margin-top: -5px;
            padding: 5px 0;
        }

            .dropdown-content::before {
                content: '';
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 15px;
            }

            .dropdown-content a {
                color: rgba(255,255,255,0.75) !important;
                padding: 12px 18px !important;
                text-decoration: none !important;
                display: block !important;
                font-size: 0.9rem !important;
                text-align: left !important;
                transition: all 0.2s ease !important;
            }

                .dropdown-content a:hover {
                    background-color: #3d342d !important;
                    color: #c9a054 !important;
                    padding-left: 22px !important;
                }

            .dropdown-content .dropdown-active {
                color: #c9a054 !important;
                font-weight: 600 !important;
                background-color: rgba(201, 160, 84, 0.05) !important;
            }

        .dropdown-admin:hover .dropdown-content {
            display: block !important;
        }

        .dropdown-admin:hover .nav-link span {
            transform: rotate(180deg);
        }
    </style>

    <script>
        const underline = document.querySelector('.nav-underline');
        function moveUnderline(element) {
            if (element && underline) {
                underline.style.left = element.offsetLeft + 'px';
                underline.style.width = element.offsetWidth + 'px';
            }
        }

        window.addEventListener('load', () => {
            const activeLink = document.querySelector('.nav-link.active');
            moveUnderline(activeLink);
        });

        window.addEventListener('resize', () => {
            const activeLink = document.querySelector('.nav-link.active');
            moveUnderline(activeLink);
        });
    </script>
</body>
</html>
