@{
    ViewData["Title"] = "Мой профиль";
}

<section class="profile-page" style="padding: 80px 0; min-height: 90vh; background: #3d342d;">
    <div class="container" style="display: flex; justify-content: center;">
        <div class="profile-card" style="background: #ece0c9; border-radius: 30px; padding: 40px; width: 100%; max-width: 450px; box-shadow: 0 15px 35px rgba(0,0,0,0.3); text-align: center;">

            <!-- БЛОК АВАТАРКИ -->
            <div class="avatar-container" style="position: relative; display: inline-block; margin-bottom: 20px;">
                <!-- Сама аватарка -->
                <img src="@(ViewBag.AvatarPath ?? "/images/default-avatar.png")"
                     style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 5px solid #d4a373; box-shadow: 0 5px 15px rgba(0,0,0,0.2);">

                <!-- СКРЫТАЯ ФОРМА ДЛЯ ОТПРАВКИ ФАЙЛА -->
                <form id="avatarForm" asp-action="UpdateAvatar" method="post" enctype="multipart/form-data" style="display: none;">
                    <!-- onchange заставит форму отправиться сразу после выбора файла -->
                    <input type="file" id="avatarInput" name="avatar" accept="image/*" onchange="document.getElementById('avatarForm').submit();">
                </form>

                <!-- Кнопка «+», которая открывает окно выбора файла -->
                <label for="avatarInput" style="position: absolute; bottom: 5px; right: 5px; background: #8b4513; color: white; width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; border: 3px solid #ece0c9; transition: 0.2s;">
                    <span style="font-size: 20px; font-weight: bold;">+</span>
                </label>
            </div>

            <h2 style="color: #3d342d; margin-bottom: 5px; font-size: 1.8em;">@ViewBag.Login</h2>
            <p style="color: #8b4513; font-style: italic; margin-bottom: 25px;">Постоянный гость Full Oven</p>

            <div style="border-top: 1px solid rgba(139, 69, 19, 0.2); padding-top: 25px;">
                <p style="color: #5d544d; line-height: 1.6; margin-bottom: 30px;">
                    Добро пожаловать в личный кабинет! Вы можете сменить фото, нажав на плюс, или выйти из системы.
                </p>
            </div>

            <!-- КНОПКА ВЫХОДА -->
            <a asp-action="Logout" style="display: block; background: #ff4d4d; color: white; text-decoration: none; padding: 15px; border-radius: 15px; font-weight: bold; transition: 0.3s; box-shadow: 0 4px 10px rgba(255, 77, 77, 0.3);">
                Выйти из аккаунта
            </a>
        </div>
    </div>
</section>
