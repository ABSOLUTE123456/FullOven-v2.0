@{
    ViewData["Title"] = "Главная";
}

<section class="hero">
    <div class="container">
        <div class="hero-content">
            <h1>Добро пожаловать</h1>
            <p>Традиционные рецепты встречаются с современными трендами в атмосфере уюта и изысканности</p>
            <a asp-controller="Home" asp-action="Menu" class="btn">Открыть меню</a>
        </div>
    </div>
</section>

<section class="about">
    <div class="container">
        <h2 class="section-title">О ресторане</h2>
        <div class="features">
            <div class="feature-card">
                <h3>Свежие продукты</h3>
                <p>Ежедневные поставки от проверенных фермеров</p>
            </div>
            <div class="feature-card">
                <h3>Высокое качество</h3>
                <p>Лучшие шеф-повара и премиальные ингредиенты</p>
            </div>
            <div class="feature-card">
                <h3>С любовью к делу</h3>
                <p>Каждое блюдо готовится с душой и вниманием к деталям</p>
            </div>
        </div>
    </div>
</section>
