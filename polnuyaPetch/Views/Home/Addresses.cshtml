@{
    ViewData["Title"] = "Наши заведения";
}

<section class="places-page" style="padding: 60px 0; background-color: #3d342d; min-height: 100vh; color: white;">
    <div class="container">
        <div class="menu-title-block" style="text-align: center; margin-bottom: 50px;">
            <h1 class="section-title" style="color: #ffffff; font-size: 2.5rem; text-transform: uppercase; border: none; margin-bottom: 10px;">
                Наши заведения
            </h1>
            <div style="width: 80px; height: 1px; background-color: #ffffff; opacity: 0.8; margin: 0 auto;"></div>
        </div>

        <div class="places-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px;">
            <!-- Левая карточка: Москва -->
            <div class="place-card">
                <div class="place-image-wrap">
                    <img src="~/images/image 10.png" alt="Москва" class="place-img">
                </div>
                <div class="place-info-box">
                    <h3>Элитный центр</h3>
                    <p>Москва, ул. Арбат, 32</p>
                    <a href="https://www.google.com/maps/d/u/1/edit?mid=15IVWs2UdMKUxkupvRQtidLjkguaLsBw&usp=sharing" target="_blank" class="map-link">Посмотреть на карте →</a>
                </div>
            </div>

            <!-- Центральная карточка: Великий Новгород -->
            <div class="place-card">
                <div class="place-image-wrap">
                    <img src="~/images/image 11.png" alt="НН" class="place-img">
                </div>
                <div class="place-info-box">
                    <h3>Уютный район</h3>
                    <p>Великий Новгород, ул. Ломоносова, 27</p>
                    <a href="https://www.google.com/maps/d/u/1/edit?mid=15IVWs2UdMKUxkupvRQtidLjkguaLsBw&usp=sharing" target="_blank" class="map-link">Посмотреть на карте →</a>
                </div>
            </div>

            <!-- Правая карточка: Сочи -->
            <div class="place-card">
                <div class="place-image-wrap">
                    <img src="~/images/image 12.png" alt="Сочи" class="place-img">
                </div>
                <div class="place-info-box">
                    <h3>Туристический</h3>
                    <p>Сочи, ЖК Новая заря, 1Б</p>
                    <a href="https://www.google.com/maps/d/u/1/edit?mid=15IVWs2UdMKUxkupvRQtidLjkguaLsBw&usp=sharing" target="_blank" class="map-link">Посмотреть на карте →</a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .place-card {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        overflow: hidden;
        transition: 0.3s;
    }

        .place-card:hover {
            transform: translateY(-10px);
            border-color: #ffffff;
        }

    .place-image-wrap {
        height: 220px;
        overflow: hidden;
    }

    .place-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .place-info-box {
        padding: 25px;
        color: white;
    }

        .place-info-box h3 {
            color: #ffffff;
            margin-bottom: 10px;
            font-size: 1.4rem;
        }

        .place-info-box p {
            font-size: 0.95rem;
            margin-bottom: 25px;
            opacity: 0.7;
            min-height: 44px;
        }

    .map-link {
        display: inline-block;
        color: #ffffff;
        border: 1px solid #ffffff;
        background: transparent;
        padding: 10px 22px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        text-align: center;
        width: 100%;
        box-sizing: border-box;
        transition: 0.3s;
    }

        .map-link:hover {
            background: white;
            color: #3d342d;
        }
</style>
